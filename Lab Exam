class A{
    private int a;
    private int b;
    protected float c;
    protected float d;
    public int e;
    public int f;
    int  priv1()
    {
        a=10;
        return a;
    }
    int priv2()
    {
        b=20;
        return b;
    }
    public A(){}
    {
        c=30;
        d=40;
       
    }
    public A(int n1, int n2)
    {
        e=50;
        f=60;
        n1=e;
        n2=f;
    }
}
class MyThread1 extends Thread{
    public void run()
    {
         for(int i=0;i<5;i++)
        {
            System.out.println("Program for using super keyword");
        }
        try{
            
            Thread.sleep(2000);
        }
        catch(InterruptedException e)
        {
            System.out.println(e);
        }
    }
}
